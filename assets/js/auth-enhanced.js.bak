          Cancel
        </button>
        <button id="saveSettingsBtn" class="flex-1 bg-gradient-to-r from-indigo-500 to-purple-500 text-white py-3 px-6 rounded-xl hover:from-indigo-600 hover:to-purple-600 transition-all duration-200 font-semibold transform hover:scale-105 shadow-lg">
          💾 Save Settings
        </button>
      </div>
    </div>
  `;
  
  // Show modal
  settingsModal.classList.remove('hidden');
  settingsModal.classList.add('flex');
  
  // Add event listeners
  document.getElementById('closeSettingsModal').addEventListener('click', () => {
    settingsModal.classList.add('hidden');
    settingsModal.classList.remove('flex');
  });
  
  document.getElementById('downloadDataBtn').addEventListener('click', () => {
    showMessage('📥 Data download feature coming soon!', 'info');
  });
  
  document.getElementById('saveSettingsBtn').addEventListener('click', async () => {
    try {
      const preferences = {
        emailNotifications: document.getElementById('emailNotifications').checked,
        soundEffects: document.getElementById('soundEffects').checked,
        darkMode: document.getElementById('darkMode').checked,
        language: document.getElementById('language').value,
        profileVisibility: document.getElementById('profileVisibility').checked
      };
      
      await updateDoc(doc(db, 'users', auth.currentUser.uid), {
        preferences: preferences,
        updatedAt: serverTimestamp()
      });
      
      showMessage('✅ Settings saved successfully!', 'success');
      settingsModal.classList.add('hidden');
      settingsModal.classList.remove('flex');
      
      // Apply dark mode if enabled
      if (preferences.darkMode) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    } catch (error) {
      console.error('Error saving settings:', error);
      showMessage('❌ Failed to save settings', 'error');
    }
  });
}

// Modal utility functions
function showModal(modalId) {
  const modal = document.getElementById(modalId);
  if (modal) {
    modal.classList.add('show');
    modal.style.display = 'flex';
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    setTimeout(() => {
      const firstInput = modal.querySelector('input:not([type="checkbox"]):not([disabled])');
      if (firstInput) firstInput.focus();
    }, 300);
  }
}

// Setup user dropdown with proper event handling
function setupUserDropdown(userData) {
  const dropdown = document.getElementById('userDropdown');
  const trigger = document.getElementById('userDropdownTrigger');
  
  if (!dropdown || !trigger) return;
  
  // Toggle dropdown
  trigger.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdown.classList.toggle('hidden');
  });
  
  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (!dropdown.contains(e.target) && !trigger.contains(e.target)) {
      dropdown.classList.add('hidden');
    }
  });
  
  // Profile modal handler
  const profileBtn = document.getElementById('openProfile');
  if (profileBtn) {
    profileBtn.addEventListener('click', () => {
      dropdown.classList.add('hidden');
      openProfileModal(userData, auth.currentUser);
    });
  }
  
  // Settings modal handler
  const settingsBtn = document.getElementById('openSettings');
  if (settingsBtn) {
    settingsBtn.addEventListener('click', () => {
      dropdown.classList.add('hidden');
      openSettingsModal(userData);
    });
  }
}

// Enhanced form initialization
document.addEventListener('DOMContentLoaded', () => {
  console.log('🚀 Initializing CollegeConnect authentication system...');
  
  // Add CSS animations for form transitions
  if (!document.getElementById('auth-animations')) {
    const styles = document.createElement('style');
    styles.id = 'auth-animations';
    styles.textContent = `
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      @keyframes slideInRight {
        from {
          opacity: 0;
          transform: translateX(30px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }
      
      .animate-fade-in {
        animation: fadeInUp 0.3s ease-out;
      }
      
      .modal-content {
        transition: all 0.3s ease-in-out;
      }
      
      .register-only {
        display: none;
      }
      
      .login-only {
        display: block;
      }
    `;
    document.head.appendChild(styles);
  }
  
  // Enhanced auth form submission
  const authForm = document.getElementById('authForm') || document.getElementById('auth-form');
  if (authForm) {
    authForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      console.log('📝 Auth form submitted');
      
      const email = (document.getElementById('authEmail') || document.getElementById('auth-email'))?.value?.trim() || '';
      const password = (document.getElementById('authPassword') || document.getElementById('auth-password'))?.value || '';
      const role = (document.getElementById('authRole') || document.getElementById('auth-role'))?.value || 'student';
      const displayName = (document.getElementById('authName') || document.getElementById('auth-name'))?.value?.trim() || '';
      const dob = (document.getElementById('authDob') || document.getElementById('auth-dob'))?.value || '';
      const gender = (document.getElementById('authGender') || document.getElementById('auth-gender'))?.value || '';
      const terms = (document.getElementById('authTerms') || document.getElementById('auth-terms'))?.checked || false;
      const mode = getCurrentMode();
      
      console.log('📊 Form data:', { email, mode, role, displayName });
      
      if (mode === 'register') {
        if (!terms) {
          showMessage('❌ Please accept the terms and conditions to continue', 'error');
          return;
        }
        await registerUser(email, password, role, { displayName, dob, gender });
      } else {
        await loginUser(email, password);
      }
    });
  }
  
  // Enhanced mode switching
  const switchBtn = document.getElementById('authSwitch') || document.getElementById('auth-switch');
  if (switchBtn) {
    switchBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const currentMode = getCurrentMode();
      const newMode = currentMode === 'register' ? 'login' : 'register';
      updateAuthModalForMode(newMode);
      
      // Clear form
      const form = document.getElementById('authForm') || document.getElementById('auth-form');
      if (form) {
        const inputs = form.querySelectorAll('input:not([type="checkbox"])');
        inputs.forEach(input => {
          if (!input.id.includes('Email') && !input.id.includes('email')) {
            input.value = '';
          }
        });
      }
    });
  }
  
  // Enhanced modal close functionality
  const authClose = document.getElementById('authClose') || document.getElementById('auth-close');
  const authBackdrop = document.getElementById('authBackdrop') || document.getElementById('auth-backdrop');
  const authModal = document.getElementById('authModal') || document.getElementById('auth-modal');
  
  if (authClose && authModal) {
    authClose.addEventListener('click', () => {
      closeAuthModal();
    });
  }
  
  if (authBackdrop && authModal) {
    authBackdrop.addEventListener('click', () => {
      closeAuthModal();
    });
  }
  
  // Enhanced forgot password functionality
  const forgotPasswordBtn = document.getElementById('forgotPassword') || document.getElementById('forgot-password');
  if (forgotPasswordBtn) {
    forgotPasswordBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('authEmail') || document.getElementById('auth-email'))?.value?.trim();
      
      if (!email) {
        showMessage('❌ Please enter your email address first', 'error');
        return;
      }
      
      try {
        await resetPassword(email);
      } catch (error) {
        // Error already handled in resetPassword function
      }
    });
  }
  
  // Enhanced keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    // Close modal with Escape key
    if (e.key === 'Escape') {
      const modals = ['authModal', 'auth-modal', 'profileModal', 'settingsModal'];
      modals.forEach(modalId => {
        const modal = document.getElementById(modalId);
        if (modal && (!modal.classList.contains('hidden') || modal.style.display === 'flex')) {
          closeAuthModal();
          if (modal.id === 'profileModal' || modal.id === 'settingsModal') {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
          }
        }
      });
    }
    
    // Quick login with Ctrl+L
    if (e.ctrlKey && e.key === 'l' && !auth.currentUser) {
      e.preventDefault();
      openAuthModal('login');
    }
    
    // Quick register with Ctrl+R
    if (e.ctrlKey && e.key === 'r' && !auth.currentUser) {
      e.preventDefault();
      openAuthModal('register');
    }
  });
  
  // Real-time validation for password strength
  const passwordInput = document.getElementById('authPassword') || document.getElementById('auth-password');
  if (passwordInput) {
    passwordInput.addEventListener('input', (e) => {
      const password = e.target.value;
      const strength = validatePassword(password);
      
      // Add visual feedback for password strength
      const strengthIndicator = document.getElementById('passwordStrength') || createPasswordStrengthIndicator();
      updatePasswordStrengthIndicator(strengthIndicator, strength);
    });
  }
  
  console.log('✅ CollegeConnect authentication system initialized successfully');
});

// Password strength indicator functions
function createPasswordStrengthIndicator() {
  const indicator = document.createElement('div');
  indicator.id = 'passwordStrength';
  indicator.className = 'mt-2 transition-all duration-300';
  
  const passwordInput = document.getElementById('authPassword') || document.getElementById('auth-password');
  if (passwordInput && passwordInput.parentNode) {
    passwordInput.parentNode.appendChild(indicator);
  }
  
  return indicator;
}

function updatePasswordStrengthIndicator(indicator, strength) {
  if (!indicator) return;
  
  const strengthLevels = ['Very Weak', 'Weak', 'Fair', 'Good', 'Strong'];
  const strengthColors = ['bg-red-500', 'bg-red-400', 'bg-yellow-400', 'bg-blue-500', 'bg-green-500'];
  const strengthTextColors = ['text-red-600', 'text-red-500', 'text-yellow-600', 'text-blue-600', 'text-green-600'];
  
  const level = Math.min(strength.strength, 4);
  const strengthText = strengthLevels[level];
  const barColor = strengthColors[level];
  const textColor = strengthTextColors[level];
  
  indicator.innerHTML = `
    <div class="flex items-center gap-2">
      <div class="flex-1 bg-gray-200 rounded-full h-2">
        <div class="${barColor} h-2 rounded-full transition-all duration-300" style="width: ${(level + 1) * 20}%"></div>
      </div>
      <span class="text-xs font-medium ${textColor}">${strengthText}</span>
    </div>
    ${strength.length ? '' : '<div class="text-xs text-gray-500 mt-1">Password must be at least 6 characters</div>'}
  `;
}

// Global error handler for unhandled auth errors
window.addEventListener('unhandledrejection', (event) => {
  if (event.reason && event.reason.code && event.reason.code.startsWith('auth/')) {
    console.error('🔥 Unhandled auth error:', event.reason);
    showMessage('❌ An authentication error occurred. Please try again.', 'error');
    event.preventDefault();
  }
});

